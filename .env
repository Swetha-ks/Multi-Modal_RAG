# Copy this file to .env and fill in your details
# Get FREE Groq API key from https://console.groq.com

GROQ_API_KEY=GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b
# llama-3.1-8b-instant and llama-3.3-70b-versatile were deprecated by Groq
# on June 17, 2026. If openai/gpt-oss-20b ever stops working, check
# https://console.groq.com/docs/models for the current model list.

CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=openai

CHROMA_DB_PATH=./chroma_db
CATALOG_PATH=./data/abo_products.csv

# Voice language (en-IN = Indian English)
VOICE_LANGUAGE=en-IN

# SQLite database for user accounts, cart, wishlist, price alerts, chat history
USER_DB_PATH=./data/users.db

# Set to "true" only if you want true multimodal (image+text) catalog indexing.
# Leave "false" (default) for fast text-only indexing — real product photos
# still display fine in the UI either way.
EMBED_CATALOG_IMAGES=false

# ── Real SMS OTP delivery (optional) ──────────────────────────────
# Leave these blank to keep OTP in demo mode (shown on screen).
# Fill them in with your own Twilio account to send REAL SMS:
#   1. Sign up free at https://twilio.com
#   2. Buy/get a trial Twilio phone number
#   3. On a trial account, verify the destination number first:
#      Console → Phone Numbers → Verified Caller IDs
#   4. Copy your Account SID + Auth Token from the Twilio Console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
